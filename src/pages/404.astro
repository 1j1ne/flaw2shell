---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { url } from '../lib/url';
---
<Base title="404">
  <section class="page-head notfound">
    <p class="kicker mono">segmentation fault (core dumped)</p>
    <h1>404</h1>
    <p class="lead"><T ko="요청한 페이지를 찾을 수 없습니다. 검토 중인 글은 게시 전까지 공개되지 않습니다." en="Page not found. Posts under review are not public until published." /></p>
    <p><a href={url()}>← <T k="nav.home" /></a></p>
  </section>
</Base>
