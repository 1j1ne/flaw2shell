---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import T from '../components/T.astro';
import { UI } from '../lib/i18n';
import { url } from '../lib/url';

interface Props { title?: string; description?: string; active?: string }
const { title, description = UI['site.desc'].en, active = '' } = Astro.props;
const fullTitle = title ? `${title} · flaw2shell` : 'flaw2shell — ' + UI['site.tagline'].en;
const nav = [
  { href: '', key: 'nav.home', id: 'home' },
  { href: 'classes/', key: 'nav.classes', id: 'classes' },
  { href: 'quiz/', key: 'nav.quiz', id: 'quiz' },
  { href: 'ai-security/', key: 'nav.ai', id: 'ai' },
  { href: 'about/', key: 'nav.about', id: 'about' },
] as const;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark light" />
    <!-- 페인트 전에 테마/언어 적용 (깜빡임 방지). 다크가 기본. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t = 'dark', l = 'en';
        try { t = localStorage.getItem('f2s-theme') || 'dark'; l = localStorage.getItem('f2s-lang') || 'en'; } catch (e) {}
        d.dataset.theme = t; d.dataset.lang = l; d.lang = l;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main"><T k="nav.skip" /></a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={url()} aria-label="flaw2shell home">
          <span class="logo-prompt" aria-hidden="true">$</span><span class="logo-text">flaw<b>2</b>shell</span><span class="logo-cursor" aria-hidden="true"></span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={url(n.href)} aria-current={active === n.id ? 'page' : undefined}><T k={n.key} /></a>
          ))}
        </nav>
        <div class="header-tools">
          <button type="button" class="tool-btn" id="lang-toggle" aria-label="Language / 언어">
            <span class="l-ko">EN</span><span class="l-en">KO</span>
          </button>
          <button type="button" class="tool-btn" id="theme-toggle" aria-label="테마 전환 / Toggle theme">
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <p class="footer-brand"><span class="logo-prompt">$</span> flaw2shell</p>
          <p class="muted"><T k="site.desc" /></p>
        </div>
        <div class="footer-policy">
          <p><strong><T ko="책임있는 공개" en="Responsible disclosure" /></strong> — <T k="footer.disclosure" /></p>
          <p class="muted"><T k="footer.news" /> <a href={url('about/')}><T ko="원칙 자세히 보기 →" en="Read our principles →" /></a></p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var d = document.documentElement;
        function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        document.getElementById('theme-toggle').addEventListener('click', function () {
          var t = d.dataset.theme === 'dark' ? 'light' : 'dark';
          d.dataset.theme = t; save('f2s-theme', t);
        });
        document.getElementById('lang-toggle').addEventListener('click', function () {
          var l = d.dataset.lang === 'ko' ? 'en' : 'ko';
          d.dataset.lang = l; d.lang = l; save('f2s-lang', l);
          document.dispatchEvent(new CustomEvent('f2s:lang', { detail: l }));
        });
      })();
    </script>
  </body>
</html>
