# 로컬에서 `npm run pipeline` 실행 시 사용하는 값 예시.
# 이 파일을 .env 로 복사해 채운 뒤:  node --env-file=.env pipeline/run.mjs
ANTHROPIC_API_KEY=
REVIEW_EMAIL=
# Gmail 예시: 2단계 인증을 켠 뒤 "앱 비밀번호"를 만들어 SMTP_PASS 에 넣는다
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 선택
NVD_API_KEY=
F2S_MIN_CVSS=8.0
F2S_MAX_DRAFTS=3
F2S_LOOKBACK_HOURS=26
